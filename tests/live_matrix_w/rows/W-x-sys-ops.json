   },
   "assert": {
    "isError": false
   }
  },
  {
   "door": "stdio",
   "label": "jobs via tool",
   "tool": "debug_list_processes",
   "args": {
    "system": true
   },
   "assert": {
    "json_raw": {
     "len_gte": 1
    }
   }
  },
  {
   "door": "http",
   "label": "raw jobs equal door",
   "method": "GET",
   "path": "/api/atelier/v8/%25SYS/jobs?system=1",
   "auth": true,
   "assert": {
    "status": [
     200
    ]
   }
  }
 ]
}