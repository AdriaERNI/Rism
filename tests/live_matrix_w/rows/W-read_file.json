{
 "id": "W-read_file",
 "batch": "W:B4",
 "checks": [
  {
   "door": "stdio",
   "label": "happy README",
   "tool": "read_file",
   "args": {
    "path": "README.md"
   },
   "assert": {
    "json": {
     "content": {
      "regex": "."
     },
     "error": {
      "eq": null
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "C:\\RismL\\ws"
   }
  },
  {
   "door": "stdio",
   "label": "no root refuses",
   "tool": "read_file",
   "args": {
    "path": "README.md"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "not configured"
     }
    }
   },
   "probe_note": "refusal is IN-BAND: result.error set, isError false (host tools answer with an error field, not a tool error)",
   "unset": [
    "RISM_WORKSPACE"
   ],
   "scope_suffix": "-noroot"
  },
  {
   "door": "stdio",
   "label": "traversal refused",
   "tool": "read_file",
   "args": {
    "path": "C:\\Windows\\win.ini"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "escapes workspace|outside|not found|absolute"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "C:\\RismL\\ws"
   },
   "probe_note": "W edge from the ledger: an absolute path outside the root must refuse (TASK.md traversal-vs-Windows-syntax hunt)"
  },
  {
   "door": "stdio",
   "label": "binary refused",
   "tool": "read_file",
   "args": {
    "path": "blob.bin"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "(?i)binary"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "C:\\RismL\\ws"
   },
   "probe_note": "staged binary file inside the VM workspace plays the ELF-client role the Linux debug binary plays on the L side"
  }
 ]
}