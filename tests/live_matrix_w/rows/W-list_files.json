{
 "id": "W-list_files",
 "group": "L:4",
 "checks": [
  {
   "door": "stdio",
   "label": "pattern (recursive bare glob \u2014 defect fixed in src/tools/host.rs)",
   "tool": "list_files",
   "args": {
    "pattern": "*.toml"
   },
   "assert": {
    "json": {
     "files": {
      "len_gte": 1
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  },
  {
   "door": "stdio",
   "label": "dir path",
   "tool": "list_files",
   "args": {
    "path": "src",
    "pattern": "*.rs"
   },
   "assert": {
    "json": {
     "files": {
      "len_gte": 1
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  },
  {
   "door": "stdio",
   "label": "max 0 clamps",
   "tool": "list_files",
   "args": {
    "pattern": "*.rs",
    "max_results": 0
   },
   "assert": {
    "isError": false,
    "json": {
     "files": {
      "len_gte": 1
     },
     "truncated": {
      "eq": true
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  },
  {
   "door": "stdio",
   "label": "win-separator path: no such dir (Linux), never escapes",
   "tool": "list_files",
   "args": {
    "path": "..\\..\\Windows"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "escapes workspace|Path not found|not found"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   },
   "probe_note": "W edge: the backslash path is real traversal syntax on Windows \u2014 guard must refuse it (names/host split on [/]) or it simply never resolves outside root"
  },
  {
   "door": "stdio",
   "label": "nix traversal refused in-band",
   "tool": "list_files",
   "args": {
    "path": "../../etc"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "escapes workspace"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  }
 ]
}