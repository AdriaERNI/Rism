{
 "id": "W-run_shell",
 "batch": "W:B4",
 "checks": [
  {
   "door": "stdio",
   "label": "echo",
   "tool": "run_shell",
   "args": {
    "command": "echo rism-ok"
   },
   "assert": {
    "json": {
     "stdout": {
      "regex": "rism-ok"
     },
     "exit_code": {
      "eq": 0
     }
    }
   }
  },
  {
   "door": "stdio",
   "label": "exit 3",
   "tool": "run_shell",
   "args": {
    "command": "exit 3"
   },
   "assert": {
    "json": {
     "exit_code": {
      "eq": 3
     }
    }
   }
  },
  {
   "door": "stdio",
   "label": "timeout",
   "tool": "run_shell",
   "args": {
    "command": "Start-Sleep 5",
    "timeout_secs": 1
   },
   "assert": {
    "isError": true,
    "text_regex": "timeout|killed|timed"
   },
   "timeout": 60
  },
  {
   "door": "stdio",
   "label": "cwd outside root",
   "tool": "run_shell",
   "args": {
    "command": "(Get-Location).Path",
    "cwd": "C:\\Windows"
   },
   "assert": {
    "isError": false,
    "json": {
     "stdout": {
      "regex": "C:\\\\Windows"
     }
    }
   },
   "timeout": 30,
   "probe_note": "run_shell is not root-gated on Windows either (docs: same table): an absolute cwd outside the workspace works"
  },
  {
   "door": "stdio",
   "label": "hostile cwd traversal",
   "tool": "run_shell",
   "args": {
    "command": "(Get-Location).Path",
    "cwd": "../.."
   },
   "assert": {
    "json": {
     "stdout": {
      "regex": "C:"
     }
    }
   },
   "probe_note": "W leg: '../..' resolves on Windows too (run_shell is not root-gated) \u2014 stdout must show a drive-rooted path"
  },
  {
   "door": "exec",
   "label": "host oracle",
   "argv": [
    "cmd",
    "/c",
    "echo rism-ok"
   ],
   "assert": {
    "exit_code": 0,
    "stdout_regex": "rism-ok"
   }
  }
 ]
}