{
 "id": "L-cli-doc-put",
 "batch": "L:B6",
 "checks": [
  {
   "door": "exec",
   "label": "stage file",
   "argv": [
    "python3",
    "-c",
    "import pathlib; pathlib.Path('.sf-live-matrix/LaneCliPut.cls').write_text('Class RismCI.LaneCliPut Extends %RegisteredObject\\n{\\n}')"
   ],
   "assert": {
    "exit_code": 0
   }
  },
  {
   "door": "cli",
   "label": "cli doc put",
   "argv": [
    "doc",
    "put",
    "RismCI.LaneCliPut.cls",
    "--file",
    ".sf-live-matrix/LaneCliPut.cls",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "cliout"
  },
  {
   "door": "stdio",
   "label": "tool twin",
   "tool": "put_document",
   "args": {
    "name": "RismCI.LaneCliPut.cls",
    "content": [
     "Class RismCI.LaneCliPut Extends %RegisteredObject",
     "{",
     "}"
    ],
    "ignore_conflict": true
   },
   "assert": {
    "isError": false
   },
   "save": "twin"
  },
  {
   "door": "diff",
   "label": "cli mirrors tool keys",
   "a": "cliout",
   "b": "twin",
   "mode": "keys"
  },
  {
   "door": "cli",
   "label": "guard",
   "argv": [
    "doc",
    "put",
    "x/../../y.cls",
    "--file",
    "/dev/null"
   ],
   "assert": {
    "exit_code": 1,
    "stderr_regex": "invalid document name"
   }
  }
 ],
 "unplant": [
  "RismCI.LaneCliPut.cls"
 ]
}