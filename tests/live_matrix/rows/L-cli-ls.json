{
 "id": "L-cli-ls",
 "group": "L:6",
 "checks": [
  {
   "door": "stdio",
   "label": "tool twin",
   "tool": "list_files",
   "args": {
    "pattern": "**/*.toml"
   },
   "assert": {
    "isError": false
   },
   "save": "twin",
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  },
  {
   "door": "cli",
   "label": "cli happy json",
   "argv": [
    "ls",
    "--pattern",
    "**/*.toml",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "cliout",
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  },
  {
   "door": "diff",
   "label": "cli mirrors tool keys",
   "a": "cliout",
   "b": "twin",
   "mode": "keys"
  },
  {
   "door": "cli",
   "label": "traversal -> exit 1",
   "argv": [
    "ls",
    "../../etc"
   ],
   "assert": {
    "exit_code": 1,
    "stderr_regex": "escapes|outside|root"
   },
   "env": {
    "RISM_WORKSPACE": "${workspace}"
   }
  }
 ]
}