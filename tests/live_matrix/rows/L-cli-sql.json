{
 "id": "L-cli-sql",
 "batch": "L:B6",
 "checks": [
  {
   "door": "stdio",
   "label": "tool twin",
   "tool": "execute_sql",
   "args": {
    "query": "SELECT TOP 5 NAME FROM %Dictionary.CompiledClass"
   },
   "assert": {
    "isError": false
   },
   "save": "twin",
   "env": {}
  },
  {
   "door": "cli",
   "label": "cli happy json",
   "argv": [
    "sql",
    "SELECT TOP 5 NAME FROM %Dictionary.CompiledClass",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "cliout",
   "env": {}
  },
  {
   "door": "diff",
   "label": "cli mirrors tool keys",
   "a": "cliout",
   "b": "twin",
   "mode": "keys"
  },
  {
   "door": "cli",
   "label": "table render exit 0",
   "argv": [
    "sql",
    "SELECT 1+1 AS TWO"
   ],
   "assert": {
    "exit_code": 0
   }
  },
  {
   "door": "cli",
   "label": "unknown flag -> exit 2",
   "argv": [
    "sql",
    "SELECT 1",
    "--nope"
   ],
   "assert": {
    "exit_code": 2
   }
  },
  {
   "door": "cli",
   "label": "guard refusal -> exit 1",
   "argv": [
    "sql",
    "SELECT 1",
    "--namespace",
    "../x"
   ],
   "assert": {
    "exit_code": 1,
    "stderr_regex": "invalid namespace"
   }
  },
  {
   "door": "cli",
   "label": "unreachable -> exit 1 no-hang",
   "argv": [
    "sql",
    "SELECT 1",
    "--url",
    "http://127.0.0.1:1"
   ],
   "assert": {
    "exit_code": 1
   },
   "timeout": 30
  }
 ]
}