{
 "id": "L-search_code",
 "group": "L:1",
 "checks": [
  {
   "door": "stdio",
   "label": "literal mode finds fixture body",
   "tool": "search_code",
   "args": {
    "query": "SearchProbeMarker",
    "regex": false,
    "max_results": 5
   },
   "assert": {
    "json": {
     "match_count": {
      "gte": 1
     }
    }
   },
   "save": "s1"
  },
  {
   "door": "stdio",
   "label": "regex mode = metadata scan (docs: bodies need regex:false)",
   "tool": "search_code",
   "args": {
    "query": "Extends %Persistent",
    "documents": [
     "*.cls"
    ],
    "max_results": 5
   },
   "assert": {
    "json": {
     "truncated": {
      "exists": true
     }
    }
   },
   "probe_note": "USER namespace holds only the planted LRISLX.Search probe \u2014 'Extends %Persistent' legitimately tallies 0 bodies in regex/metadata mode; match_count=0 is the honest answer"
  },
  {
   "door": "stdio",
   "label": "bad ns refused",
   "tool": "search_code",
   "args": {
    "query": "x",
    "namespace": "a b"
   },
   "assert": {
    "isError": true,
    "text_regex": "invalid namespace"
   }
  },
  {
   "door": "stdio",
   "label": "huge max_results honored",
   "tool": "search_code",
   "args": {
    "query": "SearchProbeMarker",
    "max_results": 999999,
    "regex": false
   },
   "assert": {
    "json": {
     "truncated": {
      "exists": true
     }
    }
   }
  },
  {
   "door": "cli",
   "label": "cli mirrors tool",
   "argv": [
    "search",
    "SearchProbeMarker",
    "--no-regex",
    "--max",
    "5",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "c1"
  },
  {
   "door": "diff",
   "label": "cli==tool keys",
   "a": "c1",
   "b": "s1",
   "mode": "keys"
  }
 ],
 "plant": [
  {
   "name": "LRISLX.Search.cls",
   "content": [
    "Class LRISLX.Search Extends %RegisteredObject",
    "{",
    "",
    "ClassMethod Marker() As %String",
    "{",
    "    quit \"SearchProbeMarker\"",
    "}",
    "}"
   ],
   "compile": true
  }
 ],
 "unplant": [
  "LRISLX.Search.cls"
 ]
}