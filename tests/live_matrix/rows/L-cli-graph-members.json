{
 "id": "L-cli-graph-members",
 "batch": "L:B6",
 "checks": [
  {
   "door": "stdio",
   "label": "tool twin",
   "tool": "class_members",
   "args": {
    "class": "%UnitTest.TestCase"
   },
   "assert": {
    "isError": false
   },
   "save": "twin",
   "env": {}
  },
  {
   "door": "cli",
   "label": "cli happy json",
   "argv": [
    "graph",
    "members",
    "%UnitTest.TestCase",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "cliout",
   "env": {}
  },
  {
   "door": "diff",
   "label": "cli mirrors tool keys",
   "a": "cliout",
   "b": "twin",
   "mode": "keys"
  },
  {
   "door": "cli",
   "label": "allowlist refusal",
   "argv": [
    "graph",
    "members",
    "..\\x"
   ],
   "assert": {
    "exit_code": 1,
    "stderr_regex": "invalid class name"
   }
  },
  {
   "door": "cli",
   "label": "bad kind -> exit 2",
   "argv": [
    "graph",
    "members",
    "%UnitTest.TestCase",
    "--kind",
    "notakind"
   ],
   "assert": {
    "exit_code": 2
   }
  }
 ]
}