{
 "id": "L-read_file",
 "batch": "L:B4",
 "checks": [
  {
   "door": "stdio",
   "label": "happy README",
   "tool": "read_file",
   "args": {
    "path": "README.md"
   },
   "assert": {
    "json": {
     "content": {
      "regex": "."
     },
     "error": {
      "eq": null
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "/home/hermes/Projects/blkpws/Rism/.worktrees/coder"
   }
  },
  {
   "door": "stdio",
   "label": "no root refuses",
   "tool": "read_file",
   "args": {
    "path": "README.md"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "not configured"
     }
    }
   },
   "probe_note": "refusal is IN-BAND: result.error set, isError false (host tools answer with an error field, not a tool error)",
   "unset": [
    "RISM_WORKSPACE"
   ],
   "scope_suffix": "-noroot"
  },
  {
   "door": "stdio",
   "label": "traversal refused",
   "tool": "read_file",
   "args": {
    "path": "../../etc/passwd"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "escapes workspace|not found"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "/home/hermes/Projects/blkpws/Rism/.worktrees/coder"
   }
  },
  {
   "door": "stdio",
   "label": "binary refused",
   "tool": "read_file",
   "args": {
    "path": "target/debug/rism"
   },
   "assert": {
    "isError": false,
    "json": {
     "error": {
      "regex": "(?i)binary"
     }
    }
   },
   "env": {
    "RISM_WORKSPACE": "/home/hermes/Projects/blkpws/Rism/.worktrees/coder"
   }
  }
 ]
}