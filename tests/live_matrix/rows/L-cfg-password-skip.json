{
 "id": "L-cfg-password-skip",
 "batch": "L:B8",
 "checks": [
  {
   "door": "exec",
   "label": "build bad-password file",
   "argv": [
    "python3",
    "-c",
    "import pathlib,tempfile;d=pathlib.Path(tempfile.mkdtemp());(d/'config.toml').write_text('[iris]\\nbase_url = \"http://localhost:52773\"\\nusername = \"_SYSTEM\"\\npassword = \"WRONG-SECRET-XYZ\"\\n');print(d)"
   ],
   "assert": {
    "exit_code": 0
   },
   "save": "cfgdir"
  },
  {
   "door": "cli",
   "label": "file password IGNORED -> default SYS auth works",
   "argv": [
    "info",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0
   },
   "env": {
    "XDG_CONFIG_HOME": "${g:cfgdir}"
   }
  },
  {
   "door": "cli",
   "label": "secret never in stderr on auth failure",
   "argv": [
    "info",
    "--url",
    "http://localhost:52773",
    "--format",
    "json"
   ],
   "assert": {
    "exit_code": 0,
    "stderr_no_regex": "WRONG-SECRET-XYZ"
   },
   "env": {
    "XDG_CONFIG_HOME": "${cfgdir}"
   }
  }
 ]
}